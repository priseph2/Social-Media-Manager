# ─── ANTHROPIC ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── TRANSACTIONAL EMAIL (Resend) ─────────────────────────────────────────────
# Get from: https://resend.com → API Keys
# Used for: welcome emails, billing confirmations, plan change notifications
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=AI Social Manager

# ─── SERVER ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
API_SECRET_KEY=change-me-to-a-long-random-string

# ─── UPSTASH REDIS (Queue + Cache) ───────────────────────────────────────────
# Get from: https://console.upstash.com → Create Database → REST API disabled → copy Redis URL
REDIS_URL=rediss://default:YOUR_TOKEN@YOUR_ENDPOINT.upstash.io:6379

# ─── SUPABASE (PostgreSQL — metrics, decisions, brand guidelines) ─────────────
# Get from: https://supabase.com → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# ─── MONGODB ATLAS (Content history, customer data) ───────────────────────────
# Get from: https://cloud.mongodb.com → Connect → Drivers → copy connection string
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/cascades-luxury?retryWrites=true&w=majority

# ─── BUFFER (Social scheduling) ───────────────────────────────────────────────
BUFFER_ACCESS_TOKEN=
BUFFER_PROFILE_ID_INSTAGRAM=
BUFFER_PROFILE_ID_FACEBOOK=
BUFFER_PROFILE_ID_TWITTER=
BUFFER_PROFILE_ID_TIKTOK=
BUFFER_PROFILE_ID_PINTEREST=

# ─── META / INSTAGRAM ─────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ─── MAILCHIMP ────────────────────────────────────────────────────────────────
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=us1
MAILCHIMP_LIST_ID=

# ─── GOOGLE ANALYTICS 4 ───────────────────────────────────────────────────────
# Property ID: GA4 → Admin → Property → Property details
GA4_PROPERTY_ID=
# Service account credentials (IAM → Service Accounts → Keys → JSON)
# GA4_CLIENT_EMAIL and GA4_PRIVATE_KEY replace the old key-file approach
GA4_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
# Paste the private_key value from the service account JSON; \n is literal
GA4_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMII...

# ─── TIDIO (Live chat / customer service) ─────────────────────────────────────
TIDIO_API_KEY=
TIDIO_PUBLIC_KEY=

# ─── SHOPIFY (E-commerce) ─────────────────────────────────────────────────────
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# ─── NOTIFICATION / ESCALATION ────────────────────────────────────────────────
# Webhook URL to notify human manager (Slack, WhatsApp, etc.)
ESCALATION_WEBHOOK_URL=

# ─── PAYSTACK (Billing) ───────────────────────────────────────────────────────
# Get from: https://dashboard.paystack.com → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...
# Plan codes from: Paystack Dashboard → Products → Subscriptions → Plans
PAYSTACK_PLAN_CODE_STARTER=PLN_starter_code
PAYSTACK_PLAN_CODE_GROWTH=PLN_growth_code
PAYSTACK_PLAN_CODE_AGENCY=PLN_agency_code
# Dashboard URL for Paystack checkout redirect
DASHBOARD_URL=https://your-dashboard.vercel.app

# ─── MULTI-TENANT ─────────────────────────────────────────────────────────────
# For legacy API key auth: set DEFAULT_TENANT_ID to the UUID of the tenant
# that API_SECRET_KEY requests are scoped to. Create the tenant via Supabase first.
DEFAULT_TENANT_ID=

# Comma-separated allowed CORS origins (include your dashboard URL)
ALLOWED_ORIGINS=http://localhost:3001

# Super admin bootstrap (scripts/make-super-admin.js)
# Comma-separated list of emails that can be promoted to super_admin.
# Only addresses in this list will be accepted by the script.
SUPER_ADMIN_EMAILS=you@yourcompany.com
