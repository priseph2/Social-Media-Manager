{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/wake",
      "schedule": "55 19 * * *"
    },
    {
      "path": "/api/cron/daily",
      "schedule": "0 20 * * *"
    }
  ]
}
